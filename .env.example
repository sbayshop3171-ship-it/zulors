APP_NAME=Zulors

APP_URL=http://localhost

APP_ENV=local
APP_KEY=
APP_SALT="${APP_KEY}"
APP_DEBUG=true
# Replace domain.com with your actual domain.
SANCTUM_STATEFUL_DOMAINS=127.0.0.1,localhost,domain.com,www.domain.com
APP_API_PREFIX=api
APP_NEWS_RESOURCE_URL=https://t.me/zulors

# For Docker compose.
APP_SERVICE=zulors

VITE_API_BASE_URL="${APP_URL}"
VITE_APP_API_PREFIX="${APP_API_PREFIX}"
ADMIN_EMAIL=admin@example.com
BACKUP_EMAIL=backup@example.com

STATIC_STORAGE_DISK=public

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=true
R2_TEMP_ENABLED=false
R2_TEMP_BUCKET=
R2_TEMP_DISK=r2_temp
R2_TEMP_PREFIX=tmp/direct/videos
R2_FINAL_ENABLED=false
R2_FINAL_BUCKET=
R2_FINAL_DISK=r2_final
R2_FINAL_ROUND_ROBIN=false
R2_PUBLIC_URL=https://media.example.com
R2_DIRECT_UPLOAD_ENABLED=false
R2_DIRECT_UPLOAD_DISK=r2_final
R2_DIRECT_UPLOAD_PREFIX=uploads/posts/videos
R2_DIRECT_UPLOAD_EXPIRY_MINUTES=720
R2_DIRECT_UPLOAD_MULTIPART_THRESHOLD_MB=8
R2_DIRECT_UPLOAD_MULTIPART_PART_SIZE_MB=8
R2_DIRECT_UPLOAD_CONCURRENCY=8
R2_DIRECT_UPLOAD_STALL_TIMEOUT_SECONDS=120
R2_DIRECT_UPLOAD_RAW_FALLBACK_MAX_MB=64
R2_DIRECT_UPLOAD_PART_FALLBACK_MAX_MB=8
R2_DIRECT_UPLOAD_AUTO_CORS_ENABLED=true
R2_DIRECT_UPLOAD_CORS_ORIGINS=
R2_TEMP_PREVIEW_EXPIRY_MINUTES=30

CLOUDFLARE_STREAM_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=
CLOUDFLARE_STREAM_REQUIRE_SIGNED_URLS=false
CLOUDFLARE_STREAM_DIRECT_UPLOAD_EXPIRY_MINUTES=60
CLOUDFLARE_STREAM_MAX_DURATION_SECONDS=36000

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# LOG_CHANNEL=stack
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=example
DB_USERNAME=example
DB_PASSWORD=example

SESSION_DRIVER=file
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.example.com
SESSION_EXPIRE_ON_CLOSE=false

# Never change this.
BROADCAST_CONNECTION=reverb

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=localhost
REDIS_PASSWORD=null
REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"

PUSHER_DEBUG_CONSOLE=true
REVERB_APP_ID=642892
REVERB_APP_KEY=
REVERB_APP_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Reverb server (the daemon) — where it LISTENS
# ─────────────────────────────────────────────────────────────────────────────
# IP/host the Reverb process binds to. Use 0.0.0.0 to listen on all interfaces,
# or 127.0.0.1 to accept only local connections on this machine.
REVERB_SERVER_HOST=0.0.0.0

# TCP port the Reverb process listens on.
REVERB_SERVER_PORT=13000

# ─────────────────────────────────────────────────────────────────────────────
# Backend → Reverb (Laravel publisher endpoint)
# ─────────────────────────────────────────────────────────────────────────────
# The address your Laravel app uses to send events to Reverb.
# Use a hostname/IP that is reachable FROM THE LARAVEL APP.
# Examples:
#  - Same host (no proxy):      REVERB_HOST=127.0.0.1  REVERB_PORT=13000  REVERB_SCHEME=http
#  - Internal hostname (Docker): REVERB_HOST=reverb    REVERB_PORT=13000  REVERB_SCHEME=http
#  - Through HTTPS proxy (rare): REVERB_HOST=api.example.com REVERB_PORT=443 REVERB_SCHEME=https
REVERB_HOST=localhost
REVERB_PORT=13000
REVERB_SCHEME=http

# ─────────────────────────────────────────────────────────────────────────────
# Frontend (browser) → WebSocket endpoint
# ─────────────────────────────────────────────────────────────────────────────
# The public host/port/scheme the BROWSER connects to via WebSocket.
# Often this is your web server / reverse proxy (e.g., Nginx), not the raw Reverb port.
# Examples:
#  - Through Nginx on HTTP:   VITE_REVERB_HOST=site.local   VITE_REVERB_PORT=80    VITE_REVERB_SCHEME=http
#  - Through Nginx on HTTPS:  VITE_REVERB_HOST=site.com     VITE_REVERB_PORT=443   VITE_REVERB_SCHEME=https
#  - Direct to Reverb (dev):  VITE_REVERB_HOST=127.0.0.1    VITE_REVERB_PORT=13000 VITE_REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="13000"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"


VITE_REVERB_CONNECTION_STATUS=off

VITE_CALL_AUDIO_BITRATE=64000
VITE_CALL_LOW_BANDWIDTH_AUDIO_BITRATE=32000
VITE_CALL_MIN_AUDIO_BITRATE=24000
VITE_CALL_AUDIO_PROCESSING=true
VITE_CALL_QUALITY_MONITOR_INTERVAL=3000
VITE_CALL_RECONNECT_GRACE_MS=10000
# Authenticated API returns short-lived TURN credentials when these are set.
CALL_STUN_URLS=stun:stun.l.google.com:19302
CALL_TURN_URLS=
CALL_TURN_SECRET=
CALL_TURN_USERNAME=
CALL_TURN_CREDENTIAL=
CALL_TURN_TTL_SECONDS=3600
# Optional frontend fallback only. Prefer CALL_TURN_SECRET for production.
VITE_CALL_ICE_SERVERS=

VIDEO_PROCESS_LOGGING=false
AUDIO_PROCESS_LOGGING=false

MEDIA_CACHE_CONTROL="public, max-age=31536000, immutable"
MEDIA_IMAGE_MAX_WIDTH=2048
MEDIA_IMAGE_MAX_HEIGHT=2048
POST_IMAGE_QUALITY=84
POST_VIDEO_THUMBNAIL_QUALITY=84
POST_VIDEO_CRF=24
POST_VIDEO_PRESET=veryfast
POST_VIDEO_AUDIO_BITRATE=128
POST_VIDEO_MAX_WIDTH=1080
POST_VIDEO_MAX_HEIGHT=1920
MEDIA_VIDEO_QUEUE=media-video
MEDIA_AUDIO_QUEUE=media-audio
MEDIA_VIDEO_MAX_PROCESSES=1
MEDIA_AUDIO_MAX_PROCESSES=1
MEDIA_VIDEO_TIMEOUT=3600
MEDIA_AUDIO_TIMEOUT=1800

GIPHY_API_KEY=

VITE_GIPHY_API_KEY="${GIPHY_API_KEY}"
VITE_APP_NEWS_RESOURCE_URL="${APP_NEWS_RESOURCE_URL}"

SMS_DRIVER=log

IPINFO_TOKEN=

IP_GEOLOCATION_DRIVER=ipinfo

VITE_LOG_BUILD_WARNINGS=false

VITE_JS_APP_BUILD_NUMBER=10

TRANSLATION_SERVICE_API_URL=http://localhost:5000
TRANSLATION_SERVICE_API_KEY=example-key
TRANSLATION_SERVICE=libretranslate
TRANSLATION_SERVICE_NAME="LibreTranslate Self-Hosted"
TRANSLATION_SERVICE_URL=https://libretranslate.org
TRANSLATION_SERVICE_LOGO="${APP_URL}/assets/services/libretranslate-logo.png"

# --------------------------------------------------------------------------
# MAIN CONTACT INFORMATION.
# --------------------------------------------------------------------------

CONTACTS_EMAIL=contact@example.com
CONTACTS_PHONE=+1234567890
CONTACTS_ADDRESS=

# --------------------------------------------------------------------------
# USER VERIFICATION SERVICE URL
# --------------------------------------------------------------------------

VERIFICATION_SERVICE_URL=https://docs.sumsub.com/docs/user-verification

ADS_DEFAULT_APPROVAL=false

NOTIFICATIONS_EMAIL_ENABLED=false

NOTIFICATIONS_BROADCAST_ENABLED=true

NOTIFICATIONS_PUSH_ENABLED=false

FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=storage/app/private/firebase/service-account.json

# HIDE_AUTHOR_ATTRIBUTION=false
# VITE_HIDE_AUTHOR_ATTRIBUTION="${HIDE_AUTHOR_ATTRIBUTION}"

DEBUGBAR_ENABLED=false

# Add Community Starter usernames here, separated by commas (e.g. user1,user2,user3).
# New users will automatically follow these accounts after registration.
AUTO_FOLLOW_LIST=
